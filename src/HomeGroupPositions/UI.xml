<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sir.insidi.at/or/schema/esoui.xsd">
    <Controls>
        <TopLevelControl name="HomeGroupPositionsWindow" clampedToScreen="true" mouseEnabled="true" movable="true" hidden="true">
            <Dimensions x="930" y="500" />
            <DimensionConstraints minX="600" minY="300" />
            <Anchor point="CENTER" />

            <Controls>
                <Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop" />
                <Control name="$(parent)Header">
                    <Anchor point="TOPLEFT" />
                    <Anchor point="TOPRIGHT" />
                    <Dimensions y="31" />
                    <Controls>
                        <Label name="$(parent)CharacterAccountLabel" font="ZoFontGameBold" mouseEnabled="true">
                            <Anchor point="LEFT" offsetX="10" />
                        </Label>
                        <Label name="$(parent)XLabel" font="ZoFontGameBold" mouseEnabled="true">
                            <Anchor point="LEFT" relativeTo="$(parent)CharacterAccountLabel" relativePoint="RIGHT" offsetX="30" />
                        </Label>
                        <Label name="$(parent)YLabel" font="ZoFontGameBold" mouseEnabled="true">
                            <Anchor point="LEFT" relativeTo="$(parent)XLabel" relativePoint="RIGHT" offsetX="30" />
                        </Label>
                        <Label name="$(parent)ZLabel" font="ZoFontGameBold" mouseEnabled="true">
                            <Anchor point="LEFT" relativeTo="$(parent)YLabel" relativePoint="RIGHT" offsetX="30" />
                        </Label>
                        <Button name="$(parent)Close" inherits="ZO_CloseButton">
                            <Anchor point="RIGHT" offsetX="-10" />
                        </Button>
                    </Controls>
                </Control>

                <Control name="$(parent)List" inherits="ZO_ScrollList">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Toolbar" relativePoint="BOTTOMLEFT" offsetX="10" offsetY="10" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-10" offsetY="-10" />
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
